#!/usr/bin/env crystal
require "../src/asciidoctor_epub"
require "option_parser"

input_file = ""
output_file = ""

OptionParser.parse do |parser|
  parser.banner = "Usage: crystal-asciidoctor-epub3 [options] fichier.adoc"
  parser.on("-o FILE", "--out-file FILE", "Output EPUB file (default: <input>.adoc.epub)") { |f| output_file = f }
  parser.on("-h", "--help", "Show help") { puts parser; exit 0 }
  parser.on("-v", "--version", "Show version") { puts "crystal-asciidoctor-epub3 #{AsciidoctorEpub::VERSION}"; exit 0 }
  parser.unknown_args { |args| input_file = args.first? || "" }
end

if input_file.empty?
  STDERR.puts "Error: no input file specified."
  STDERR.puts "Usage: crystal-asciidoctor-epub3 [options] file.adoc"
  exit 1
end

unless File.exists?(input_file)
  STDERR.puts "Error: file '#{input_file}' does not exist."
  exit 1
end

if output_file.empty?
  output_file = File.join(
    File.dirname(input_file),
    File.basename(input_file) + ".epub"
  )
end

doc = Asciidoctor.load_file(input_file, {"safe" => "safe"})
converter = AsciidoctorEpub::Converter.new
converter.convert_to_file(doc, output_file)

puts "EPUB generated: #{output_file}"
